# Safarancho Pager — Backend config
PORT=9009
DB_PATH=pager.db
CORS_ORIGINS=*
MONGODB_URI=mongodb://localhost:27017/fitness_bot

# Mesh Network Configuration
# NODE_ID: leave unset to generate one once and keep it in pager.db (a new id
# on every restart made the old one linger on peers as a zombie node).
NODE_ID=node-alpha
# This node's reachable URL (advertised to peers) and the URL people open
# (links in Telegram notifications). PUBLIC_URL defaults to NODE_URL.
NODE_URL=https://pager.iron-siber.ru
PUBLIC_URL=https://pager.iron-siber.ru
# Seed peers; nodes met later are remembered in pager.db.
MESH_PEERS=["http://10.0.0.2:9009","http://10.0.0.3:9009"]
# Non-master nodes: the master's URL (re-registered every 10 min). Empty or
# MASTER_NODE=1 makes this node the master: it syncs the Iron Siber athlete
# directory from NeZhri's MongoDB (MONGODB_URI must be set explicitly).
MAIN_NODE_URL=
MASTER_NODE=
# Unused anonymous SSIDs (no messages, no session, nobody's favourite) are
# deleted after this many days.
ANON_TTL_DAYS=14

# NeZhri Telegram bridge: forward "написать спортсмену" messages from the Iron
# Siber leaderboard to the recipient's Telegram via the NeZhri bot. Leave URL
# empty to disable. The key must match NeZhri's PAGER_NOTIFY_API_KEY.
NEZHRI_NOTIFY_URL=https://safargaleev.com/api/pager/notify
NEZHRI_NOTIFY_API_KEY=change-me-pager-notify-key
# NeZhri registers athletes (kind=athlete, athlete_id) with this X-API-Key.
# Defaults to NEZHRI_NOTIFY_API_KEY.
DIRECTORY_API_KEY=
